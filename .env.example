# ─────────────────────────────────────────────────────────────
# SyncFlow — environment template. Copy to `.env` and adjust.
# Config is validated at boot (Joi); missing/invalid values fail fast.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──
NODE_ENV=development
API_PORT=3000
# Comma-separated list of allowed browser origins (CORS + the auth CSRF origin
# check). Each must be an http(s) URL; any path or trailing slash is ignored.
WEB_ORIGIN=http://localhost:5173

# ── PostgreSQL ──
POSTGRES_USER=syncflow
POSTGRES_PASSWORD=syncflow_dev_pw
POSTGRES_DB=syncflow
# Used by Prisma from the host machine. Host port is 5433 (compose maps 5433->5432)
# to avoid clashing with a locally-installed PostgreSQL on 5432.
# From inside compose, the api service uses host `postgres` and port 5432.
DATABASE_URL=postgresql://syncflow:syncflow_dev_pw@localhost:5433/syncflow?schema=public

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO locally / S3 in prod) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=syncflow-assets
S3_ACCESS_KEY=syncflow
S3_SECRET_KEY=syncflow_dev_pw
S3_FORCE_PATH_STYLE=true

# ── Auth ──
# Dev default below is public; production refuses it and requires ≥ 32 chars
# (openssl rand -hex 32). Refresh tokens are opaque, so there is no refresh secret.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ── Operations (optional; defaults shown per environment) ──
# Proxy hops to trust for req.ip — 1 in production (Render), 0 otherwise.
# TRUST_PROXY=0
# Swagger UI at /api/v1/docs — true outside production, false in production.
# SWAGGER_ENABLED=true
# Rate-limit counters: redis (shared across instances) or memory (tests).
# THROTTLE_STORAGE=redis
# Pino level: fatal|error|warn|info|debug|trace|silent (debug dev, info prod, error test).
# LOG_LEVEL=debug
# Days a soft-deleted board (snapshots, members, invites, uploaded images) is
# kept before a background job hard-deletes it. Integer >= 1; default 30.
# BOARD_PURGE_AFTER_DAYS=30

# ── Web (Vite, build-time) ──
# REST base URL — MUST include the /api/v1 prefix. Relative in dev (proxied by
# Vite); a full https:// URL in prod, e.g. https://api.syncflows.xyz/api/v1
VITE_API_URL=/api/v1
# Socket.io origin — a BARE origin, no path (the client appends /socket.io).
# Defaults to http://localhost:3000 in dev; in prod e.g. https://api.syncflows.xyz
# VITE_SYNC_URL=http://localhost:3000
